# Required for Speak→Sign speech recognition. The Node server can start without
# it, but microphone capture will be disabled until this is configured.
DEEPGRAM_API_KEY=your_deepgram_api_key_here
PORT=3000

# Optional: English -> ASL gloss via OpenAI. If unset, the raw transcript is
# signed (still lemmatized + fingerspelled by the Python server).
OPENAI_API_KEY=your_openai_api_key_here
# Use a small/fast model to keep live latency low.
OPENAI_MODEL=gpt-4o-mini
# Fall back to raw transcript if a gloss call takes longer than this (ms).
GLOSS_TIMEOUT_MS=1500

# Sign→Speak mode: ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional: override the default voice (Rachel = 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
